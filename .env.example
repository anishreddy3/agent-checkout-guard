# Local development. Copy to .env and `set -a; . ./.env; set +a` before npm start.
PORT=8080
# Leave unset for the in-memory store; set to use Firestore (needs ADC or a service account).
# GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini via Google AI Studio:
# GEMINI_API_KEY=...
# or via Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global   (Gemini 3 is served from the global endpoint)
GEMINI_MODEL=gemini-3-flash-preview
# Retried once on this model if the primary call fails or times out:
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional: Sarvam speech (Bulbul, Saaras) for Indian languages in voice step-up.
# Without it, every language uses Google Cloud Text-to-Speech and Gemini listening.
# SARVAM_API_KEY=...
# Optional: AP2 signing keys as JSON (node scripts/gen-ap2-keys.js). Without it each
# process generates its own keys, which is fine for one local instance.
# AP2_KEYS={...}
# Optional: protects POST /api/reset
# ADMIN_TOKEN=change-me
