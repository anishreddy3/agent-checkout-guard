# Local development. Copy to .env and `set -a; . ./.env; set +a` before npm start.
PORT=8080
# Leave unset for the in-memory store; set to use Firestore (needs ADC or a service account).
# GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini via Google AI Studio:
# GEMINI_API_KEY=...
# or via Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Optional: Sarvam speech (Bulbul, Saaras) for Indian languages in voice step-up.
# Without it, every language uses Google Cloud Text-to-Speech and Gemini listening.
# SARVAM_API_KEY=...
# Optional: protects POST /api/reset
# ADMIN_TOKEN=change-me
